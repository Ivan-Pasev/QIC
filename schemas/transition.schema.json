{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qic.invalid/schemas/transition.schema.json",
  "title": "QIC G4 Transition Objects",
  "$defs": {
    "family": {"enum": ["T0", "T1", "T2", "T3", "T4", "T5"]},
    "failure": {"enum": ["UNKNOWN_OPERATION", "FAMILY_NOT_ENABLED", "STALE_STATE", "SUBJECT_MISMATCH", "AUTHORITY_DENIED", "RULE_REJECTED", "INVARIANT_FAILED"]},
    "entry": {
      "type": "array",
      "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "entries"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "actor", "operation", "expected_state_digest", "payload"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"},
        "expected_state_digest": {"type": "string", "minLength": 1},
        "payload": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "failure", "proposal_digest", "before_state", "after_state", "failed_invariant"],
      "properties": {
        "accepted": {"type": "boolean"},
        "failure": {"anyOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]},
        "proposal_digest": {"type": "string", "minLength": 1},
        "before_state": {"$ref": "#/$defs/state"},
        "after_state": {"$ref": "#/$defs/state"},
        "failed_invariant": {"type": ["string", "null"]}
      }
    }
  },
  "description": "G4 structural schema only. Proposal is not commit; T4/T5 remain disabled in the reference compute profile."
}
